{
  "manifest_version": 3,
  "name": "YouTube Gesture Control",
  "version": "1.0.0",
  "description": "Controls YouTube playback via hand gestures detected by the desktop app.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Gesture Control",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  }
}
